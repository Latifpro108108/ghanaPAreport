# PowerAlert GH Flutter - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# DO NOT add real values to this file and commit to Git!

# ==========================================
# FIREBASE CONFIGURATION
# ==========================================
# Android API Key
FIREBASE_API_KEY_ANDROID=your_android_api_key_here

# iOS API Key (if you add iOS support)
FIREBASE_API_KEY_IOS=your_ios_api_key_here

# Firebase Project ID
FIREBASE_PROJECT_ID=your_project_id_here

# Firebase App ID
FIREBASE_APP_ID=your_app_id_here

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here

# ==========================================
# REALTIME DATABASE
# ==========================================
# Database URL
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ==========================================
# GOOGLE MAPS (if you add map features later)
# ==========================================
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==========================================
# APP CONFIGURATION
# ==========================================
# App Name
APP_NAME=PowerAlert GH

# Default Country Code for phone
DEFAULT_COUNTRY_CODE=+233

# Debug Mode (true/false)
DEBUG_MODE=true
